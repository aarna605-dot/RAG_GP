# Copy to .env and fill in. NEVER commit .env or paste keys into code. All optional except the LLM for S1-S5.
DEFAULT_AGENT=mock

# Folder with R2's src/, indices/, corpus_v0/ and papers.csv. Leave blank when this app sits inside the repo.
RAG_REPO_PATH=

# One LLM for every setup (the brief: same model, temperature 0). Gemini's OpenAI-compatible endpoint shown;
# any OpenAI-style provider works. Pick a model your key can use, e.g. gemini-2.5-flash.
LLM_API_KEY=your_google_api_key_here
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# If answers come back empty on a "thinking" model, uncomment:
# LLM_REASONING_EFFORT=low
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# LangSmith tracing (leave the key blank to turn it off)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agentic-rag
